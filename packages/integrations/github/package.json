{
  "name": "@tramo/github",
  "version": "0.2.1",
  "description": "GitHub integration pack for tramo — issues, PRs, releases, files, dispatches, webhook triggers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@tramo/spec": "0.2.1",
    "@tramo/runtime": "0.2.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "tramo",
    "workflow",
    "integration",
    "github"
  ],
  "author": "Juan Denis",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhd3197/tramo.git"
  },
  "homepage": "https://github.com/jhd3197/tramo#readme",
  "bugs": {
    "url": "https://github.com/jhd3197/tramo/issues"
  }
}
