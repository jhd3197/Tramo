{
  "name": "@tramo/twilio",
  "version": "0.1.0",
  "description": "Twilio integration pack for tramo — SMS, WhatsApp, voice, incoming-message webhook.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "tramo-spec": "0.1.0",
    "tramo-runtime": "0.1.0"
  },
  "devDependencies": { "typescript": "^5.4.0" },
  "keywords": ["tramo", "workflow", "integration", "twilio"],
  "author": "Juan Denis",
  "license": "MIT",
  "engines": { "node": ">=18" }
}
