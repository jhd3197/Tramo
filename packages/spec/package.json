{
  "name": "@tramo/spec",
  "version": "0.2.0",
  "description": "The tramo workflow spec — pure-data types, document utilities, and the canonical node-definition registry. Shared between the editor (tramo) and every runtime (@tramo/runtime, future tramo-runtime-py).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patches": {
      "types": "./dist/patches.d.ts",
      "import": "./dist/patches.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./nodes": {
      "types": "./dist/nodes.d.ts",
      "import": "./dist/nodes.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "workflow",
    "spec",
    "schema",
    "tramo",
    "automation"
  ],
  "author": "Juan Denis",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhd3197/tramo.git"
  },
  "homepage": "https://github.com/jhd3197/tramo#readme",
  "bugs": {
    "url": "https://github.com/jhd3197/tramo/issues"
  }
}
