{
  "name": "tramo",
  "version": "0.0.1",
  "description": "Embeddable workflow editor + runtime. Umbrella meta-package re-exporting @tramo/editor, @tramo/spec, @tramo/runtime, and every first-party brand integration pack from one install.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./styles.css": "./dist/styles.css",
    "./integrations/gmail": {
      "types": "./dist/integrations/gmail.d.ts",
      "import": "./dist/integrations/gmail.js"
    },
    "./integrations/github": {
      "types": "./dist/integrations/github.d.ts",
      "import": "./dist/integrations/github.js"
    },
    "./integrations/telegram": {
      "types": "./dist/integrations/telegram.d.ts",
      "import": "./dist/integrations/telegram.js"
    },
    "./integrations/discord": {
      "types": "./dist/integrations/discord.d.ts",
      "import": "./dist/integrations/discord.js"
    },
    "./integrations/notion": {
      "types": "./dist/integrations/notion.d.ts",
      "import": "./dist/integrations/notion.js"
    },
    "./integrations/openai": {
      "types": "./dist/integrations/openai.d.ts",
      "import": "./dist/integrations/openai.js"
    },
    "./integrations/anthropic": {
      "types": "./dist/integrations/anthropic.d.ts",
      "import": "./dist/integrations/anthropic.js"
    },
    "./integrations/linear": {
      "types": "./dist/integrations/linear.d.ts",
      "import": "./dist/integrations/linear.js"
    },
    "./integrations/airtable": {
      "types": "./dist/integrations/airtable.d.ts",
      "import": "./dist/integrations/airtable.js"
    },
    "./integrations/stripe": {
      "types": "./dist/integrations/stripe.d.ts",
      "import": "./dist/integrations/stripe.js"
    },
    "./integrations/cloudflare": {
      "types": "./dist/integrations/cloudflare.d.ts",
      "import": "./dist/integrations/cloudflare.js"
    },
    "./integrations/google-drive": {
      "types": "./dist/integrations/google-drive.d.ts",
      "import": "./dist/integrations/google-drive.js"
    },
    "./integrations/google-sheets": {
      "types": "./dist/integrations/google-sheets.d.ts",
      "import": "./dist/integrations/google-sheets.js"
    },
    "./integrations/google-tasks": {
      "types": "./dist/integrations/google-tasks.d.ts",
      "import": "./dist/integrations/google-tasks.js"
    },
    "./integrations/outlook": {
      "types": "./dist/integrations/outlook.d.ts",
      "import": "./dist/integrations/outlook.js"
    },
    "./integrations/postgres": {
      "types": "./dist/integrations/postgres.d.ts",
      "import": "./dist/integrations/postgres.js"
    },
    "./integrations/twilio": {
      "types": "./dist/integrations/twilio.d.ts",
      "import": "./dist/integrations/twilio.js"
    },
    "./integrations/youtube": {
      "types": "./dist/integrations/youtube.d.ts",
      "import": "./dist/integrations/youtube.js"
    },
    "./integrations/x": {
      "types": "./dist/integrations/x.d.ts",
      "import": "./dist/integrations/x.js"
    },
    "./integrations/trello": {
      "types": "./dist/integrations/trello.d.ts",
      "import": "./dist/integrations/trello.js"
    },
    "./integrations/box": {
      "types": "./dist/integrations/box.d.ts",
      "import": "./dist/integrations/box.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:ts && npm run build:css",
    "build:ts": "tsc -p tsconfig.json",
    "build:css": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/styles.css','dist/styles.css');\"",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@tramo/spec": "0.0.1",
    "@tramo/runtime": "0.0.1",
    "@tramo/editor": "0.0.1",
    "@tramo/gmail": "0.0.1",
    "@tramo/github": "0.0.1",
    "@tramo/telegram": "0.0.1",
    "@tramo/discord": "0.0.1",
    "@tramo/notion": "0.0.1",
    "@tramo/openai": "0.0.1",
    "@tramo/anthropic": "0.0.1",
    "@tramo/linear": "0.0.1",
    "@tramo/airtable": "0.0.1",
    "@tramo/stripe": "0.0.1",
    "@tramo/cloudflare": "0.0.1",
    "@tramo/google-drive": "0.0.1",
    "@tramo/google-sheets": "0.0.1",
    "@tramo/google-tasks": "0.0.1",
    "@tramo/outlook": "0.0.1",
    "@tramo/postgres": "0.0.1",
    "@tramo/twilio": "0.0.1",
    "@tramo/youtube": "0.0.1",
    "@tramo/x": "0.0.1",
    "@tramo/trello": "0.0.1",
    "@tramo/box": "0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "workflow",
    "node-editor",
    "automation",
    "embeddable",
    "react",
    "ai",
    "agent"
  ],
  "author": "Juan Denis",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhd3197/tramo.git"
  },
  "homepage": "https://github.com/jhd3197/tramo#readme",
  "bugs": {
    "url": "https://github.com/jhd3197/tramo/issues"
  }
}
